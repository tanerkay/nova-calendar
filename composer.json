{
    "name": "wdelfuego/nova-calendar",
    "description": "A powerful event calendar Tool for Laravel's Nova 4 / 5.",
    "keywords": [
        "laravel",
        "nova",
        "calendar",
        "event-calendar",
        "events",
        "date"
    ],
    "license": [
      "AGPL-3.0-or-later",
      "proprietary"
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10|^11|^12|^13",
        "laravel/nova": "^5.0",
        "wdelfuego/nova-datetime": "dev-nova-5-support"
    },
    "autoload": {
        "psr-4": {
            "Wdelfuego\\NovaCalendar\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wdelfuego\\NovaCalendar\\ToolServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://nova.laravel.com"
        },
        {
            "type": "git",
            "url": "https://github.com/tanerkay/nova-datetime"
        }
    ]
}
